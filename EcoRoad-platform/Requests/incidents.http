# Incident and Remediation Management requests.
# Run them in order from Rider or Visual Studio. The demo board is seeded in Development.
@host = http://localhost:5000

### Board summary
GET {{host}}/api/incidents/summary?companyId=demo-company

### List the incidents of the board
GET {{host}}/api/incidents?companyId=demo-company&projectId=prj-lima-canta

### Open an incident from an alert
# @name incident
POST {{host}}/api/incidents
Content-Type: application/json

{
  "companyId": "demo-company",
  "alertId": "ALR-030",
  "projectId": "prj-lima-canta",
  "sectionId": "lim-01",
  "title": "PM10 above the warning threshold",
  "description": "Dust cloud generated by trucks at the access road.",
  "severity": "Warning",
  "openedBy": "usr-carlos"
}

> {% client.global.set("incidentId", response.body.id); %}

### Assign the responsible person
POST {{host}}/api/incidents/{{incidentId}}/assignment
Content-Type: application/json

{
  "userId": "usr-luis",
  "userName": "Luis Garcia"
}

### Register a corrective action
# @name action
POST {{host}}/api/incidents/{{incidentId}}/actions
Content-Type: application/json

{
  "description": "Water the access road every two hours.",
  "assignedBy": "usr-carlos"
}

> {% client.global.set("actionId", response.body.id); %}

### Report progress of the action
PUT {{host}}/api/incidents/{{incidentId}}/actions/{{actionId}}/progress
Content-Type: application/json

{
  "progressPercentage": 50
}

### Complete the action
POST {{host}}/api/incidents/{{incidentId}}/actions/{{actionId}}/execution

### Record field evidence
POST {{host}}/api/incidents/{{incidentId}}/evidence
Content-Type: application/json

{
  "notes": "Photographs of the watered road and a control PM10 reading.",
  "fileUrl": "https://storage.ecoroad.pe/evidence/alr-030-01.jpg",
  "registeredBy": "usr-luis"
}

### Mark the incident as attended
POST {{host}}/api/incidents/{{incidentId}}/resolution

### Close the incident
POST {{host}}/api/incidents/{{incidentId}}/closure
Content-Type: application/json

{
  "closedBy": "usr-carlos",
  "notes": "Control readings back under the warning threshold."
}

### Consult the incident
GET {{host}}/api/incidents/{{incidentId}}
